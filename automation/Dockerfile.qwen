ARG BROWSER_RUNTIME_IMAGE
FROM ${BROWSER_RUNTIME_IMAGE}

WORKDIR /app

COPY --chown=10001:10001 any2api_automation ./any2api_automation
COPY --chown=10001:10001 pyproject.toml uv.lock check_runtime_version.py ./

RUN uv export --frozen --no-dev --no-emit-project --no-header --no-annotate \
        --format requirements-txt --output-file /tmp/expected-runtime-requirements.txt > /dev/null \
    && /app/.venv/bin/python check_runtime_version.py --dependencies /tmp/expected-runtime-requirements.txt \
    && uv pip install --python /app/.venv/bin/python --no-deps --reinstall-package any2api-automation . \
    && uv pip check --python /app/.venv/bin/python \
    && /app/.venv/bin/python check_runtime_version.py

ENV ANY2API_AUTOMATION_ENABLED_PROVIDERS=qwen

EXPOSE 8090
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/sh", "-c", "Xvfb :99 -screen 0 1365x900x24 -nolisten tcp -ac & for i in $(seq 1 50); do [ -S /tmp/.X11-unix/X99 ] && break; sleep 0.1; done; [ -S /tmp/.X11-unix/X99 ] || exit 1; export DISPLAY=:99; exec /app/.venv/bin/uvicorn any2api_automation.main:app --host 0.0.0.0 --port 8090"]

FROM python:3.12-slim-bookworm AS dependencies

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/
WORKDIR /locks
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --no-header --no-annotate \
    --format requirements-txt --output-file requirements.txt > /dev/null

FROM python:3.12-slim-bookworm AS browser-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    MOZ_DISABLE_CONTENT_SANDBOX=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    XDG_CACHE_HOME=/opt/any2api-cache

WORKDIR /app

ARG TARGETARCH
ARG SING_BOX_VERSION=1.13.14
ARG CAMOUFOX_VERSION=official/152.0.4-beta.28-3a105a2f

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl fonts-liberation fonts-noto-color-emoji fonts-noto-cjk \
        libasound2 libatk-bridge2.0-0 libatk1.0-0 libcups2 libdbus-1-3 \
        libdrm2 libgbm1 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 \
        libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 \
        libxfixes3 libxkbcommon0 libxrandr2 libxshmfence1 libxss1 libxtst6 \
        tini tzdata xvfb \
    && test "$TARGETARCH" = "arm64" \
    && curl -fsSL "https://github.com/SagerNet/sing-box/releases/download/v${SING_BOX_VERSION}/sing-box-${SING_BOX_VERSION}-linux-arm64.tar.gz" \
        | tar -xz -C /tmp \
    && install -m 0755 "/tmp/sing-box-${SING_BOX_VERSION}-linux-arm64/sing-box" /usr/local/bin/sing-box \
    && rm -rf "/tmp/sing-box-${SING_BOX_VERSION}-linux-arm64" \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /bin/
COPY --from=dependencies /locks/requirements.txt /opt/any2api-runtime/requirements.txt
RUN useradd --system --uid 10001 --create-home automation \
    && install -d -m 1777 /tmp/.X11-unix \
    && install -d -o automation -g automation /app /ms-playwright /opt/any2api-cache

USER 10001
RUN uv venv /app/.venv \
    && uv pip install --python /app/.venv/bin/python --require-hashes \
        --requirements /opt/any2api-runtime/requirements.txt \
    && /app/.venv/bin/patchright install chromium \
    && /app/.venv/bin/python -m camoufox fetch "${CAMOUFOX_VERSION}"

COPY check_browser_environment.py /opt/any2api-runtime/check_browser_environment.py

# Keep system graphics dependencies separate from large downloaded browser layers.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libegl1 libgles2 \
    && rm -rf /var/lib/apt/lists/*

USER 10001
RUN /app/.venv/bin/python /opt/any2api-runtime/check_browser_environment.py

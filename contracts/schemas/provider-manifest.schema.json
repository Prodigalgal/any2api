{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://any2api.local/schemas/provider-manifest.schema.json",
  "title": "Provider Manifest",
  "type": "object",
  "required": ["id", "adapter_version", "request_schema_version", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
    "display_name": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "request_schema_version": { "type": "string", "minLength": 1 },
    "default_models": { "type": "array", "items": { "type": "string" } },
    "routing_aliases": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" },
      "uniqueItems": true
    },
    "provider_options_schema": { "type": "object" },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "enum": ["NATIVE", "EMULATED", "UNSUPPORTED"] }
    }
  },
  "additionalProperties": false
}

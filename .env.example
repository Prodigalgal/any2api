POSTGRES_DB=any2api
POSTGRES_USER=any2api
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

ANY2API_ADMIN_USERNAME=admin
ANY2API_ADMIN_PASSWORD=replace-with-at-least-8-random-characters
ANY2API_PUBLIC_API_KEY=replace-with-at-least-24-random-characters
ANY2API_INTERNAL_TOKEN=replace-with-at-least-24-random-characters
# Generate with: openssl rand -base64 32
ANY2API_CREDENTIAL_MASTER_KEY=replace-with-base64-for-exactly-32-random-bytes
ANY2API_PROXY_BOOTSTRAP_DIRECTORY=
ANY2API_PROXY_BOOTSTRAP_POOL_NAME=Self-hosted Oracle

# Shared registration runtime. Keep passwords and authenticated proxy URLs in deployment secrets.
ANY2API_AUTOMATION_LOG_LEVEL=INFO
ANY2API_AUTOMATION_MAIL_API_BASE=https://mail.example.com
ANY2API_AUTOMATION_MAIL_ADMIN_PASSWORD=replace-with-mail-admin-password
ANY2API_AUTOMATION_MAIL_SITE_PASSWORD=
ANY2API_AUTOMATION_MAIL_DOMAIN=
ANY2API_AUTOMATION_REGISTRATION_PROXY_URL=
# Secret VLESS subscription returned by the CF dynamic proxy service.
ANY2API_AUTOMATION_DYNAMIC_PROXY_SUBSCRIPTION_URL=
ANY2API_AUTOMATION_REGISTRATION_USE_DYNAMIC_PROXY=true
ANY2API_AUTOMATION_MINMAX_REQUIRE_DYNAMIC_PROXY=true
ANY2API_AUTOMATION_REGISTRATION_HEADLESS=true
# Optional OpenAI-compatible vision solver used only after local captcha solvers cannot decide.
ANY2API_AUTOMATION_CAPTCHA_AI_ENABLED=false
ANY2API_AUTOMATION_CAPTCHA_AI_API_BASE=
ANY2API_AUTOMATION_CAPTCHA_AI_API_KEY=
ANY2API_AUTOMATION_CAPTCHA_AI_MODEL=
ANY2API_AUTOMATION_CAPTCHA_AI_PROMPT_PREFIX=
ANY2API_AUTOMATION_CAPTCHA_AI_ACTION_SAMPLES=5
ANY2API_AUTOMATION_CAPTCHA_AI_ACTION_SAMPLE_TIMEOUT_SECONDS=60
ANY2API_AUTOMATION_CAPTCHA_AI_TIMEOUT_SECONDS=90
ANY2API_AUTOMATION_CAPTCHA_DIAGNOSTICS_DIR=
ANY2API_AUTOMATION_CAPTCHA_DIAGNOSTICS_MAX_FILES=200
ANY2API_AUTOMATION_GLM_REGISTRATION_BROWSER_ATTEMPTS=4
ANY2API_AUTOMATION_DEEPSEEK_BASE_URL=https://chat.deepseek.com
ANY2API_AUTOMATION_DEEPSEEK_REGISTRATION_BROWSER_ATTEMPTS=4
ANY2API_AUTOMATION_BROWSER_TRANSPORT_ALLOWED_ORIGINS=https://grok.com,https://assets.grok.com,https://imagine-public.x.ai,https://imgen.x.ai,https://accounts.x.ai,https://console.x.ai,https://chat.z.ai,https://chat.deepseek.com,https://fe-static.deepseek.com
ANY2API_AUTOMATION_BROWSER_CLEARANCE_TIMEOUT_SECONDS=120
ANY2API_AUTOMATION_BROWSER_CLEARANCE_ATTEMPTS=2
ANY2API_AUTOMATION_GROK_TURNSTILE_USE_FLOW_PROXY=true
ANY2API_MEDIA_PUBLIC_BASE_URL=
# Optional fallback only. MiMo first discovers the current public key from official assets.
ANY2API_AUTOMATION_MIMO_REGISTRATION_PUBLIC_KEY_DER=

# Optional direct-upstream overrides. Account credentials are imported through the admin API.
ANY2API_PROVIDER_GROK_BASE_URL=https://cli-chat-proxy.grok.com/v1
ANY2API_PROVIDER_GROK_CLIENT_VERSION=0.2.112
ANY2API_AUTOMATION_GROK_SIGNIN_URL=https://accounts.x.ai/sign-in?redirect=grok-com
ANY2API_PROVIDER_MIMO_BASE_URL=https://aistudio.xiaomimimo.com
ANY2API_PROVIDER_QWEN_BASE_URL=https://chat.qwen.ai
ANY2API_PROVIDER_GLM_BASE_URL=https://chat.z.ai
ANY2API_PROVIDER_GLM_FRONTEND_VERSION=1.1.79
ANY2API_PROVIDER_GLM_SIGNATURE_KEY=key-@@@@)))()((9))-xxxx&&&%%%%%
ANY2API_PROVIDER_DEEPSEEK_BASE_URL=https://chat.deepseek.com
ANY2API_PROVIDER_LONGCAT_BASE_URL=https://longcat.chat
ANY2API_PROVIDER_MINMAX_BASE_URL=https://agent.minimax.io
ANY2API_PROVIDER_MINMAX_STREAM_BASE_URL=https://agent-stream.minimax.io
ANY2API_PROVIDER_MINMAX_PROFILE_ASSET_HOSTS=cdn.hailuoai.com

AUTOMATION_BASE_URL=http://automation:8090
NEXT_PUBLIC_API_BASE_URL=
ANY2API_SERVER_INTERNAL_URL=http://server:8080
# Optional observability retention windows.
ANY2API_OBSERVABILITY_OPERATION_RETENTION=30d
ANY2API_OBSERVABILITY_USAGE_RETENTION=90d
ANY2API_OBSERVABILITY_CLEANUP_INTERVAL=1h
ANY2API_OBSERVABILITY_CLEANUP_INITIAL_DELAY=10m
